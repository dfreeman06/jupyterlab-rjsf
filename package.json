{
  "name": "@polusai/jupyterlab-rjsf",
  "version": "1.1.1",
  "description": "React JSON Schema Form for JupyterLab",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension"
  ],
  "homepage": "https://github.com/PolusAI/jupyterlab-rjsf",
  "bugs": {
    "url": "https://github.com/PolusAI/jupyterlab-rjsf/issues"
  },
  "license": "BSD-3-Clause",
  "author": "LabShare",
  "files": [
    "{lib,style,src}/**/*.{d.ts,eot,gif,html,jpg,js,js.map,json,png,svg,woff2,ttf,css,ts,tsx}",
    "LICENSE"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/PolusAI/jupyterlab-rjsf.git"
  },
  "scripts": {
    "build": "jlpm build:lib && jlpm build:labextension:dev",
    "build:labextension": "jupyter labextension build .",
    "build:labextension:dev": "jupyter labextension build --development True .",
    "build:lib": "tsc --sourceMap",
    "build:lib:prod": "tsc",
    "build:prod": "jlpm clean && jlpm build:lib:prod && jlpm build:labextension",
    "clean": "jlpm clean:lib",
    "clean:all": "jlpm clean:lib && jlpm clean:labextension && jlpm clean:lintcache",
    "clean:labextension": "rimraf jupyterlab_rjsf/labextension",
    "clean:lib": "rimraf lib tsconfig.tsbuildinfo",
    "clean:lintcache": "rimraf .eslintcache .stylelintcache",
    "deduplicate": "jlpm dlx yarn-berry-deduplicate -s fewerHighest && jlpm install",
    "eslint": "jlpm eslint:check --fix",
    "eslint:check": "eslint . --cache --ext .ts,.tsx",
    "install:extension": "jlpm build",
    "lint": "jlpm stylelint && jlpm prettier && jlpm eslint",
    "lint:check": "jlpm stylelint:check && jlpm prettier:check && jlpm eslint:check",
    "prepack": "npm run build",
    "prettier": "jlpm prettier:base --write --list-different",
    "prettier:base": "prettier \"**/*{.ts,.tsx,.js,.jsx,.css,.json,.md}\"",
    "prettier:check": "jlpm prettier:base --check",
    "stylelint": "jlpm stylelint:check --fix",
    "stylelint:check": "stylelint --cache \"style/**/*.css\"",
    "watch": "run-p watch:src watch:labextension",
    "watch:labextension": "jupyter labextension watch .",
    "watch:lib": "tsc -w",
    "watch:src": "tsc -w --sourceMap",
    "upload": "jlpm publish ."
  },
  "dependencies": {
    "@jupyter-widgets/base": "^6.0.10",
    "@jupyter-widgets/controls": "^5.0.11",
    "@jupyter-widgets/jupyterlab-manager": "^5.0.13",
    "@jupyterlab/application": "^4.2.5",
    "@jupyterlab/apputils": "^4.3.6",
    "@jupyterlab/codemirror": "^4.3.6",
    "@jupyterlab/rendermime": "^4.3.6",
    "@rjsf/core": "~5.24.8",
    "@rjsf/validator-ajv8": "~5.24.8",
    "codemirror": "^6.0.1",
    "react-codemirror2": "^8.0.1"
  },
  "devDependencies": {
    "@jupyterlab/builder": "^4.3.6",
    "@types/react": "^18.0.26",
    "@types/react-dom": "^19.0.4",
    "npm-run-all": "^4.1.5",
    "react": "^18.3.1",
    "rimraf": "^5.0.1",
    "typescript": "~5.0.2"
  },
  "jupyterlab": {
    "extension": "lib/plugin",
    "outputDir": "./jupyterlab_rjsf/labextension/",
    "sharedPackages": {
      "@jupyter-widgets/base": {
        "bundled": false,
        "singleton": true
      },
      "@jupyter-widgets/controls": {
        "bundled": false,
        "singleton": true
      },
      "@jupyter-widgets/jupyterlab-manager": {
        "bundled": false,
        "singleton": true
      }
    }
  }
}
